# Copy to .env.local and fill in. Never commit real values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings -> Database -> Connection string) ---
# Pooled connection used by the app at runtime
DATABASE_URL=
# Direct connection used by Prisma migrations
DIRECT_URL=

# --- Email (Brevo, transactional) ---
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=IBA Connect

# --- Identity rules ---
# Email domain accepted for Microsoft sign-in (FR1.1)
IBA_EMAIL_DOMAIN=khi.iba.edu.pk

# --- Seed and tests ---
# Comma-separated emails promoted to ADMIN when the seed runs (FR8.5). Only way to become admin.
SEED_ADMIN_EMAILS=
# Demo members created by the seed (use 1000 for the search performance test, NFR2)
SEED_MEMBER_COUNT=60
# Throwaway database for integration tests (never the real one; tests empty its tables)
TEST_DATABASE_URL=
